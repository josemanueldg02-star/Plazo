# Copia este archivo como .env y rellénalo. El .env real nunca se sube a git.
# Genera el secreto con:  openssl rand -base64 32
SERVER_PEPPER=cambia-esto-por-un-secreto-aleatorio
PORT=8787
HOST=127.0.0.1
# Orígenes autorizados (https://tu-dominio, capacitor://localhost para la app nativa)
ALLOWED_ORIGINS=capacitor://localhost
# Solo "true" si hay exactamente un proxy inverso de confianza delante (Caddy, Nginx)
TRUST_PROXY=false
# Si se omite, los datos viven en memoria y se pierden al reiniciar
DATA_FILE=./data/plazo.json
SESSION_TTL_SECONDS=3600
# "false" solo en desarrollo: permite sincronizar sin suscripción
REQUIRE_SUBSCRIPTION=true
